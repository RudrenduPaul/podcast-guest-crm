    "podcast",
    "podcast-crm",
    "guest-booking",
    "podcast-management",
    "outreach-automation",
    "ai-crm",
    "nextjs",
    "fastify",
    "monorepo",
    "claude-ai"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.9",
