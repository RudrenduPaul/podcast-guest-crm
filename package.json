{
  "name": "podcast-guest-crm",
  "private": true,
  "description": "AI-native CRM for podcast guest booking: lifecycle pipeline, AI outreach drafting, and a real CLI.",
  "keywords": [
    "podcast",
    "podcast-crm",
    "guest-booking",
    "podcast-management",
    "outreach-automation",
    "ai-crm",
    "nextjs",
    "fastify",
    "monorepo",
    "claude-ai"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.18",
      "js-yaml": "^4.3.1",
      "fast-uri": "^3.1.5",
      "brace-expansion@^1.0.0": "^1.1.18",
      "brace-expansion@^2.0.0": "^2.1.4",
      "brace-expansion@^5.0.0": "^5.0.9",
      "find-my-way": "^9.7.0",
      "sharp": "^0.35.3",
      "hono": "^4.13.1",
      "postcss": "^8.5.26",
      "fast-jwt": "^6.2.4",
      "glob": "^10.5.0",
      "vite": "^6.4.3"
    }
  }
