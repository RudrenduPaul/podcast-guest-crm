{
  "name": "podcast-guest-crm-cli",
  "version": "0.1.6",
  "mcpName": "io.github.RudrenduPaul/podcast-guest-crm",
  "description": "Command-line client for Podcast Guest CRM: manage the guest lifecycle (discover, outreach, scheduled, recorded, published, follow_up), draft AI outreach emails, and pull pipeline analytics from your terminal or an agent. Ships a Model Context Protocol server (`podcast-guest-crm-cli mcp`).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "podcast-guest-crm-cli": "./bin/podcast-guest-crm-cli.js",
    "pgcrm": "./bin/podcast-guest-crm-cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node20",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "podcast",
    "guest-crm",
    "cli",
    "outreach",
    "supabase",
    "fastify",
    "agent-native",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Rudrendu Paul",
  "contributors": [
    "Sourav Nandy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/podcast-guest-crm.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RudrenduPaul/podcast-guest-crm#readme",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/podcast-guest-crm/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
